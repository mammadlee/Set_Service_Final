# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/setservice?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/setservice?schema=public"

# Redis (required in production for OTP rate/cooldown/block state)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# QR HMAC
QR_HMAC_SECRET="replace-with-a-long-random-production-qr-secret"
QR_TOKEN_TTL_SECONDS="300"
KIOSK_SESSION_TTL_HOURS="12"
KIOSK_PUBLIC_BASE_URL="http://localhost:5174"

# Sentry
SENTRY_DSN=""

# Firebase (FCM push notifications)
PUSH_NOTIFICATIONS_ENABLED="false"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# App
PORT=3000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8080"

# SMS provider
SMS_PROVIDER="console"
SMS_API_URL=""
SMS_API_KEY=""
SMS_FROM="SET Service"

# Email provider
EMAIL_PROVIDER="console"
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="SET Service <no-reply@setservice.az>"

# Document upload/storage preparation
STORAGE_PROVIDER="r2"
LOCAL_UPLOAD_DIR="uploads"
STORAGE_PUBLIC_BASE_URL="/uploads"
S3_BUCKET="set-service"
S3_REGION=""
S3_ENDPOINT="https://58568e16fc5bba8c22e82d26903164fd.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="5fd927e90bb0c3285e27e1d42244ee8a"
S3_SECRET_ACCESS_KEY="e294da6e1178f9dc4f3bc17dd022c4c96ac40d3ff73267493e05418d6a90652e"

# OTP security
OTP_PEPPER="replace-with-a-long-random-production-otp-pepper"
OTP_TEST_MODE="true"
OTP_TEST_CODE="123456"
OTP_LOG_CODES="true"

# Optional seed/smoke credentials
SEED_ADMIN_EMAIL="admin@setservice.az"
SEED_ADMIN_PASSWORD=""
SEED_OPS_ADMIN_EMAIL="ops@setservice.az"
SEED_REPORTS_ADMIN_EMAIL="reports@setservice.az"
SEED_RESTRICTED_ADMIN_PASSWORD=""
SEED_COMPANY_EMAIL="company@setservice.az"
SEED_COMPANY_PASSWORD=""
SEED_WORKER_PASSWORD=""
SMOKE_ADMIN_PASSWORD=""
