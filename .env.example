# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hireapp?schema=public"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# QR HMAC
QR_HMAC_SECRET="change-this-too-min-32-chars"

# Sentry
SENTRY_DSN=""

# Firebase (FCM push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# App
PORT=3000
NODE_ENV="development"

# SMS provider (test mühitində OTP həmişə 123456)
SMS_API_KEY=""
SMS_FROM=""

# OTP security
OTP_PEPPER="change-this-otp-hmac-pepper-min-32-chars"
OTP_TEST_MODE="true"
OTP_TEST_CODE="123456"
OTP_LOG_CODES="true"
