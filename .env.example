# Database
DATABASE_URL="<database-url>"
DIRECT_URL="<database-url>"

# Redis (required in production)
REDIS_URL="<redis-url>"
TRUST_PROXY_CIDRS=""
RATE_LIMIT_ACTOR_WINDOW_MS="900000"
RATE_LIMIT_ACTOR_MAX="600"

# JWT (independent 256-bit base64url values; inject different secret references)
JWT_ACCESS_SECRET="<secret-reference>"
JWT_REFRESH_SECRET="<secret-reference>"
JWT_ISSUER="set-service-api"
JWT_AUDIENCE="set-service-clients"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REGISTRATION_EXPIRES_IN="30m"

# QR / kiosk
QR_HMAC_SECRET="<secret-reference>"
KIOSK_TOKEN_ENCRYPTION_SECRET="<secret-reference>"
QR_TOKEN_TTL_SECONDS="300"
KIOSK_SESSION_TTL_HOURS="12"
KIOSK_PUBLIC_BASE_URL="http://localhost:5174"

# Application
PORT="3000"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8080"
# Use lax/strict when API and web apps are same-site. Use none only for an
# intentional cross-site HTTPS topology; None cookies are always Secure.
AUTH_COOKIE_SAME_SITE="lax"
SWAGGER_DOCS_ENABLED="true"
SENTRY_DSN=""

# Durable outbox topology
# Production API deployments should keep this false and run `npm run start:outbox`
# as a separately supervised service. Use true only for an intentional single-process topology.
OUTBOX_WORKER_ENABLED="false"
OUTBOX_HEALTH_PORT="3001"
OUTBOX_MAX_CONSECUTIVE_FAILURES="5"
OUTBOX_HEARTBEAT_TTL_SECONDS="30"
OUTBOX_PROCESSED_RETENTION_DAYS="30"
OUTBOX_DEAD_RETENTION_DAYS="90"
OTP_RETENTION_DAYS="30"
REFRESH_TOKEN_RETENTION_DAYS="90"
AUDIT_LOG_RETENTION_DAYS="365"

# SMS / email providers (console is development-only)
SMS_PROVIDER="pg365"
SMS_API_URL=""
SMS_API_KEY="<secret-reference>"
SMS_FROM="SET Service"
# Production OTP provider
PG365_API_URL="https://api.poctgoyercini.com"
PG365_PUBLIC_KEY="<secret-reference>"
PG365_PRIVATE_KEY="<secret-reference>"
PG365_ORIGINATOR="SET"
PG365_TIMEOUT_MS="10000"
EMAIL_PROVIDER="console"
EMAIL_API_URL=""
EMAIL_API_KEY="<secret-reference>"
EMAIL_FROM="SET Service <no-reply@setservice.az>"
PROVIDER_OUTBOX_ENCRYPTION_SECRET="<secret-reference>"
PROVIDER_HTTP_TIMEOUT_MS="8000"
PROVIDER_HTTP_MAX_ATTEMPTS="2"
PROVIDER_HTTP_RETRY_BASE_MS="250"
PROVIDER_CIRCUIT_FAILURE_THRESHOLD="5"
PROVIDER_CIRCUIT_RESET_MS="60000"

# Private document storage; public base is only for explicitly public assets
STORAGE_PROVIDER="r2"
LOCAL_UPLOAD_DIR="uploads"
PRIVATE_DOWNLOAD_SIGNING_SECRET="<secret-reference>"
STORAGE_SIGNED_URL_TTL_SECONDS="300"
MALWARE_SCANNER_PROVIDER="http"
MALWARE_SCAN_REQUIRED="true"
MALWARE_SCANNER_URL="https://<scanner-host>/scan"
MALWARE_SCANNER_API_KEY="<secret-reference>"
MALWARE_SCANNER_TIMEOUT_MS="10000"
MALWARE_SCANNER_MAX_ATTEMPTS="2"
STORAGE_PUBLIC_BASE_URL=""
S3_BUCKET="set-service"
S3_REGION="auto"
S3_ENDPOINT="<r2-account-endpoint>"
S3_ACCESS_KEY_ID="<r2-access-key-id>"
S3_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# OTP security
OTP_PEPPER="<secret-reference>"
OTP_TEST_MODE="false"
OTP_TEST_CODE=""
OTP_LOG_CODES="false"

# Firebase (optional; required when push is enabled in production)
PUSH_NOTIFICATIONS_ENABLED="false"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL="<secret-reference>"
FIREBASE_PRIVATE_KEY="<secret-reference>"

# Optional seed/smoke credentials
ALLOW_PRODUCTION_SEED="false"
SEED_ADMIN_EMAIL="admin@setservice.az"
SEED_ADMIN_PASSWORD="<secret-reference>"
SEED_OPS_ADMIN_EMAIL="ops@setservice.az"
SEED_REPORTS_ADMIN_EMAIL="reports@setservice.az"
SEED_RESTRICTED_ADMIN_PASSWORD="<secret-reference>"
SEED_COMPANY_EMAIL="company@setservice.az"
SEED_COMPANY_PASSWORD="<secret-reference>"
SEED_WORKER_PASSWORD="<secret-reference>"
SMOKE_ADMIN_PASSWORD="<secret-reference>"
