{
  "name": "@set-service/qr-kiosk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "typecheck": "tsc --noEmit",
    "test:release-config": "node --test ../../scripts/validate-web-env.test.mjs",
    "test:security": "node --test ../../scripts/web-security-regression.test.mjs",
    "prebuild": "node ../../scripts/validate-web-env.mjs kiosk",
    "build": "tsc && vite build",
    "postbuild": "node ../../scripts/verify-built-security-headers.mjs dist"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.4.5",
    "vite": "^8.1.5"
  }
}
