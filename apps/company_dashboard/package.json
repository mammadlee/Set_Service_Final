{
  "name": "company_dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:release-config": "node --test ../../scripts/validate-web-env.test.mjs",
    "test:security": "node --test ../../scripts/web-security-regression.test.mjs",
    "prebuild": "node ../../scripts/validate-web-env.mjs company",
    "build": "tsc && vite build",
    "postbuild": "node ../../scripts/verify-built-security-headers.mjs dist",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2"
  }
}
