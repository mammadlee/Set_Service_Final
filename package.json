{
  "name": "setservice-api",
  "version": "1.0.0",
  "description": "SET Service workforce operations API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch scripts --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "smoke:mvp": "ts-node scripts/mvp-flow-smoke.ts",
    "swagger:check": "node -e \"const fs=require('fs'); const yaml=require('js-yaml'); yaml.load(fs.readFileSync('swagger.yaml','utf8')); console.log('swagger.yaml OK')\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^12.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.3",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
