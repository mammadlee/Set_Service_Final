{
  "name": "setservice-api",
  "version": "1.0.0",
  "description": "SET Service workforce operations API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch scripts --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "start:outbox": "node dist/outbox-worker.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:pg365-sms && npm run test:provider-delivery && npm run test:jwt-rotation",
    "test:pg365-sms": "ts-node scripts/pg365-sms-regression.ts",
    "test:jwt-rotation": "ts-node scripts/jwt-rotation-regression.ts",
    "smoke:mvp": "ts-node scripts/mvp-flow-smoke.ts",
    "test:auth-security": "ts-node scripts/auth-security-regression.ts",
    "test:worker-security": "ts-node scripts/worker-security-regression.ts",
    "test:text-id-locks": "ts-node scripts/text-id-lock-regression.ts",
    "test:document-backfill": "ts-node scripts/private-document-backfill-regression.ts",
    "test:backend-access": "ts-node scripts/backend-access-regression.ts",
    "test:backend-infrastructure": "ts-node scripts/backend-infrastructure-regression.ts",
    "test:audit-transactions": "ts-node scripts/audit-transaction-regression.ts",
    "test:privacy-deletion": "ts-node scripts/privacy-deletion-regression.ts",
    "test:approval-document-security": "ts-node scripts/approval-document-security-regression.ts",
    "test:seed-security": "ts-node scripts/seed-security-regression.ts",
    "test:provider-delivery": "ts-node scripts/provider-delivery-regression.ts",
    "test:orders-hardening": "ts-node scripts/orders-hardening-regression.ts",
    "test:lifecycle-concurrency": "ts-node scripts/lifecycle-concurrency-regression.ts",
    "test:release-runbooks": "ts-node scripts/release-runbook-regression.ts",
    "test:release-security": "ts-node scripts/release-security-regression.ts",
    "test:dependency-policy": "node scripts/dependency-policy-regression.mjs",
    "documents:backfill": "ts-node scripts/private-document-backfill.ts",
    "security:jwt-rotation": "ts-node scripts/invalidate-auth-sessions.ts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "swagger:check": "node -e \"const fs=require('fs'); const yaml=require('js-yaml'); yaml.load(fs.readFileSync('swagger.yaml','utf8')); console.log('swagger.yaml OK')\"",
    "swagger:drift": "node scripts/check-swagger-drift.mjs",
    "swagger:security": "node scripts/swagger-security-regression.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.66.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.7",
    "form-data": "2.5.6",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1",
    "websocket-driver": "0.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.3",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
