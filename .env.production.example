# -----------------------------------------------------------------------------
# Compose/release metadata (non-secret)
# -----------------------------------------------------------------------------
NODE_BASE_IMAGE="node:24.22.0-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315"
RUNTIME_BASE_IMAGE="gcr.io/distroless/nodejs24-debian13:nonroot@sha256:59c479c9b8c123e66047315c968aa2d35e31ae5149c856e4110a79c8b3563f0b"
REDIS_IMAGE="redis:7.4.10-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2"
CADDY_IMAGE="caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d"
CLAMAV_IMAGE="clamav/clamav:stable@sha256:78810772a92b4a9168115bc6b2e0ffd702640893b9577f8c3d0432762d2655c4"
RELEASE_TAG="local"
RELEASE_SHA="unknown"

# Caddy / Docker networking. TRUST_PROXY_CIDRS must match PROXY_SUBNET.
API_DOMAIN="api.setservice.az"
ACME_EMAIL="<operator-email>"
PROXY_SUBNET="172.30.0.0/24"
BACKEND_SUBNET="172.31.0.0/24"
EGRESS_SUBNET="172.32.0.0/24"
SCANNER_SUBNET="172.33.0.0/24"
SCANNER_UPDATES_SUBNET="172.34.0.0/24"
TRUST_PROXY_CIDRS="172.30.0.0/24"

# -----------------------------------------------------------------------------
# Application and browser policy
# -----------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
APP_TIME_ZONE="Asia/Baku"
REDIS_URL="redis://redis:6379"
CORS_ORIGINS="https://admin.setservice.az,https://company.setservice.az,https://qr.setservice.az"
AUTH_COOKIE_SAME_SITE="lax"
SWAGGER_DOCS_ENABLED="false"
RATE_LIMIT_ACTOR_WINDOW_MS="900000"
RATE_LIMIT_ACTOR_MAX="600"

# -----------------------------------------------------------------------------
# Neon PostgreSQL
# DATABASE_URL: pooled runtime URL. DIRECT_URL: direct migration URL.
# -----------------------------------------------------------------------------
DATABASE_URL="<neon-pooled-url>"
DIRECT_URL="<neon-direct-url>"

# -----------------------------------------------------------------------------
# Independent cryptographic secrets (generate each separately; 32+ random chars)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="<secret-reference>"
JWT_REFRESH_SECRET="<secret-reference>"
JWT_ISSUER="set-service-api"
JWT_AUDIENCE="set-service-clients"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REGISTRATION_EXPIRES_IN="30m"
QR_HMAC_SECRET="<secret-reference>"
KIOSK_TOKEN_ENCRYPTION_SECRET="<secret-reference>"
OTP_PEPPER="<secret-reference>"
PROVIDER_OUTBOX_ENCRYPTION_SECRET="<secret-reference>"
PRIVATE_DOWNLOAD_SIGNING_SECRET=""

# -----------------------------------------------------------------------------
# QR / kiosk
# -----------------------------------------------------------------------------
QR_TOKEN_TTL_SECONDS="300"
KIOSK_SESSION_TTL_HOURS="12"
ATTENDANCE_CHECKOUT_GRACE_MINUTES="240"
KIOSK_PUBLIC_BASE_URL="https://qr.setservice.az"

# -----------------------------------------------------------------------------
# Production OTP safety
# -----------------------------------------------------------------------------
OTP_TEST_MODE="false"
OTP_TEST_CODE=""
OTP_LOG_CODES="false"

# -----------------------------------------------------------------------------
# Durable outbox and retention
# -----------------------------------------------------------------------------
OUTBOX_WORKER_ENABLED="false"
OUTBOX_HEALTH_PORT="3001"
OUTBOX_MAX_CONSECUTIVE_FAILURES="5"
OUTBOX_HEARTBEAT_TTL_SECONDS="30"
OUTBOX_PROCESSED_RETENTION_DAYS="30"
OUTBOX_DEAD_RETENTION_DAYS="90"
OTP_RETENTION_DAYS="30"
REFRESH_TOKEN_RETENTION_DAYS="90"
AUDIT_LOG_RETENTION_DAYS="365"
ATTENDANCE_QR_RETENTION_DAYS="30"

# -----------------------------------------------------------------------------
# SMS provider (required for production registration/recovery)
# -----------------------------------------------------------------------------
SMS_PROVIDER="pg365"
SMS_API_URL=""
SMS_API_KEY=""
SMS_FROM="SET Service"
PG365_API_URL="https://api.poctgoyercini.com"
PG365_PUBLIC_KEY="<secret-reference>"
PG365_PRIVATE_KEY="<secret-reference>"
PG365_ORIGINATOR="SET"
PG365_TIMEOUT_MS="10000"

# Email is used by company/admin flows; console delivery is forbidden in production.
# Resend requires RESEND_API_KEY and EMAIL_FROM. The generic_http alternative
# requires EMAIL_API_URL, EMAIL_API_KEY, and EMAIL_FROM instead.
EMAIL_PROVIDER="resend"
RESEND_API_KEY="<secret-reference>"
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="SET Service <no-reply@setservice.az>"

PROVIDER_HTTP_TIMEOUT_MS="8000"
PROVIDER_HTTP_MAX_ATTEMPTS="2"
PROVIDER_HTTP_RETRY_BASE_MS="250"
PROVIDER_CIRCUIT_FAILURE_THRESHOLD="5"
PROVIDER_CIRCUIT_RESET_MS="60000"

# -----------------------------------------------------------------------------
# Cloudflare R2 / S3-compatible private storage
# The old repository credential must be revoked; inject a newly issued token.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="r2"
LOCAL_UPLOAD_DIR="uploads"
STORAGE_SIGNED_URL_TTL_SECONDS="300"
STORAGE_PUBLIC_BASE_URL="<public-profile-assets-origin>"
S3_BUCKET="<r2-bucket-name>"
S3_REGION="auto"
S3_ENDPOINT="<r2-s3-endpoint>"
S3_ACCESS_KEY_ID="<new-r2-access-key-id>"
S3_SECRET_ACCESS_KEY="<new-r2-secret-access-key>"

# Sensitive document uploads require a real malware scanning service in production.
MALWARE_SCANNER_PROVIDER="http"
MALWARE_SCAN_REQUIRED="true"
MALWARE_SCANNER_URL="http://malware-scanner:8080/scan"
MALWARE_SCANNER_API_KEY="<secret-reference>"
MALWARE_SCANNER_TIMEOUT_MS="10000"
MALWARE_SCANNER_MAX_ATTEMPTS="2"

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
SENTRY_DSN=""
PUSH_NOTIFICATIONS_ENABLED="false"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Production seeding remains disabled. Deployment never runs seed automatically.
ALLOW_PRODUCTION_SEED="false"

# Store-review provisioning is a separate, one-off operator action. Keep both
# gates false in the long-running service environment. Inject identifiers and
# passwords only for the one-off plan/apply/readiness commands. The provision
# gate is checked for every --apply invocation and never inferred from NODE_ENV.
ALLOW_PRODUCTION_REVIEW_PROVISION="false"
ALLOW_PRODUCTION_REVIEW_ADOPTION="false"
# One-off apply attestation. Keep false in services. Set true only after the
# outbox worker is paused and all processing provider events have drained.
STORE_REVIEW_OUTBOX_QUIESCED="false"
STORE_REVIEW_WORKER_PHONE="<secret-reference>"
STORE_REVIEW_COMPANY_PHONE="<secret-reference>"
STORE_REVIEW_COMPANY_EMAIL="<secret-reference>"
STORE_REVIEW_ADMIN_PHONE="<secret-reference>"
STORE_REVIEW_ADMIN_EMAIL="<secret-reference>"
STORE_REVIEW_WORKER_PASSWORD="<secret-reference>"
STORE_REVIEW_COMPANY_PASSWORD="<secret-reference>"
STORE_REVIEW_ADMIN_PASSWORD="<secret-reference>"
